# OpenAI API 配置
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Writing LLM config
LLM_API_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-v4-flash
GLM_API_URL=https://api.beaicloud.com/endpoint/your-endpoint-id/v1
GLM_API_KEY=
GLM_API_MODEL=your-glm-model-id
LLM_REQUEST_TIMEOUT=120
LLM_MAX_TOKENS=4000

# Agent runtime. The active model is the concrete LLM_MODEL_NAME above.
AGENT_MAX_CONCURRENT_RUNS=3
AGENT_CHECKPOINT_PATH=./agent_checkpoints.sqlite
AGENT_SKILLS_ROOT=../skills
LANGGRAPH_STRICT_MSGPACK=true

# Optional native providers
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Field extraction LLM config
FIELD_EXTRACTION_MODEL_ID=qwen2.5-72b
FIELD_EXTRACTION_MODEL_NAME=Qwen2.5-72B-Instruct
FIELD_EXTRACTION_API_URL=http://model.example.edu/v1
FIELD_EXTRACTION_API_KEY=
FIELD_EXTRACTION_TIMEOUT=120

# KnG service used by writing-assistant
KNG_BASE_URL=http://127.0.0.1:15001
KNG_QUERY_TIMEOUT=120

# Optional public web search. Leave empty to keep internet retrieval disabled.
# WEB_SEARCH_PROVIDER: responses (provider-native, capability-dependent), tavily, or brave.
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT=20

# Request-scoped reference writing uploads
REFERENCE_MAX_FILES=8
REFERENCE_MAX_FILE_MB=20
REFERENCE_MAX_TOTAL_MB=50
REFERENCE_MAX_PARSED_CHARS=40000
REFERENCE_PARSE_CONCURRENCY=2
REFERENCE_ANALYSIS_CONCURRENCY=2

# 应用配置
PORT=8000
DEBUG=True

# 数据库配置
DATABASE_URL=sqlite:///./writing_assistant.db

# CORS 配置（生产环境中应该设置具体的域名，而不是*）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
