# ===== 字段提取 LLM（必填）=====
# MODEL_ID 是内部别名（路由默认值写死 qwen2.5-72b，仅作字典查找用），实际模型看 MODEL_NAME
FIELD_EXTRACTION_MODEL_ID=qwen2.5-72b
FIELD_EXTRACTION_MODEL_NAME=your-model-name
FIELD_EXTRACTION_API_URL=https://your-llm-endpoint/v1
FIELD_EXTRACTION_API_KEY=your-api-key
FIELD_EXTRACTION_TIMEOUT=180

# ===== PDF 解析（MinerU 服务，做文件解析时必填）=====
MINERU_API_URL=https://your-mineru-server
MINERU_VLM_URL=https://your-mineru-server
MINERU_REQUEST_TIMEOUT=180
MINERU_PARSE_TIMEOUT=600
MINERU_POLL_INTERVAL=2

# ===== 内容检查（二合一 /all-check，一般用代码默认值即可）=====
# ALL_CHECK_URL=https://your-check-server/all-check
# ALL_CHECK_TIMEOUT=180

# ===== 服务启动（一般用 start.sh 默认值即可）=====
# PYTHON_BIN=/usr/bin/python3
# PORT=8050
# HOST=0.0.0.0
# LOG_FILE=./doc-extract.log

# ===== 可选：首页抬头 OCR 区域与渲染倍率 =====
# OCR_TOP_LEFT_REGION=0,0,0.42,0.18
# OCR_RENDER_SCALE=3
